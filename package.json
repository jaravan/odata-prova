{
  "name": "odata-prova",
  "version": "0.2.3",
  "description": "Mock OData V2 and V4 server generated from a service's metadata.xml",
  "license": "Apache-2.0",
  "author": "John Aravanis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaravan/odata-prova.git"
  },
  "homepage": "https://github.com/jaravan/odata-prova#readme",
  "bugs": "https://github.com/jaravan/odata-prova/issues",
  "keywords": [
    "odata",
    "odata-v2",
    "odata-v4",
    "mock",
    "mockserver",
    "metadata",
    "csdl",
    "sap",
    "fiori",
    "ui5"
  ],
  "bin": {
    "odata-prova": "dist/server.js",
    "odata-prova-mock-data": "dist/mock-data.js"
  },
  "main": "dist/lib/app.js",
  "types": "dist/lib/app.d.ts",
  "type": "module",
  "files": [
    "dist/",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@4.12.0",
  "scripts": {
    "start": "node server.ts examples/PurchaseOrderSrv",
    "dev": "node --watch server.ts examples/PurchaseOrderSrv",
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepack": "yarn build",
    "test": "node --test test/*.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc",
    "lint": "eslint ."
  },
  "dependencies": {
    "@types/express": "5.0.6",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
