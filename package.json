{
  "name": "odata-prova",
  "version": "0.2.3",
  "description": "Mock OData V2 and V4 server generated from a service's metadata.xml",
  "license": "Apache-2.0",
  "author": "John Aravanis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaravan/odata-prova.git"
  },
  "homepage": "https://github.com/jaravan/odata-prova#readme",
  "bugs": "https://github.com/jaravan/odata-prova/issues",
  "keywords": [
    "odata",
    "odata-v2",
    "odata-v4",
    "mock",
    "mockserver",
    "metadata",
    "csdl",
    "sap",
    "fiori",
    "ui5"
  ],
  "bin": {
    "odata-prova": "server.ts",
    "odata-prova-mock-data": "mock-data.ts"
  },
  "main": "lib/app.ts",
  "type": "module",
  "files": [
    "server.ts",
    "mock-data.ts",
    "lib/",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@4.12.0",
  "scripts": {
    "start": "node server.ts examples/PurchaseOrderSrv",
    "dev": "node --watch server.ts examples/PurchaseOrderSrv",
    "test": "node --test test/*.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc"
  },
  "dependencies": {
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "prettier": "3.9.9",
    "typescript": "6.0.3"
  }
}
