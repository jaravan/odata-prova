<?xml version="1.0" encoding="utf-8"?>
<!-- A many-to-many link (Students <-> Courses) with no ReferentialConstraint, like
     Northwind's Customers <-> CustomerDemographics. The server cannot join it, so it must
     disable those two navigations and still serve everything else. -->
<edmx:Edmx Version="1.0" xmlns:edmx="http://schemas.microsoft.com/ado/2007/06/edmx">
  <edmx:DataServices m:DataServiceVersion="2.0" xmlns:m="http://schemas.microsoft.com/ado/2007/08/dataservices/metadata">
    <Schema Namespace="School" xmlns="http://schemas.microsoft.com/ado/2008/09/edm">
      <EntityType Name="Student">
        <Key><PropertyRef Name="StudentId"/></Key>
        <Property Name="StudentId" Type="Edm.Int32" Nullable="false"/>
        <Property Name="Name" Type="Edm.String"/>
        <NavigationProperty Name="Courses" Relationship="School.StudentCourses" FromRole="Students" ToRole="Courses"/>
      </EntityType>
      <EntityType Name="Course">
        <Key><PropertyRef Name="CourseId"/></Key>
        <Property Name="CourseId" Type="Edm.Int32" Nullable="false"/>
        <Property Name="Title" Type="Edm.String"/>
        <NavigationProperty Name="Students" Relationship="School.StudentCourses" FromRole="Courses" ToRole="Students"/>
      </EntityType>
      <Association Name="StudentCourses">
        <End Type="School.Student" Role="Students" Multiplicity="*"/>
        <End Type="School.Course" Role="Courses" Multiplicity="*"/>
      </Association>
      <EntityContainer Name="SchoolEntities" m:IsDefaultEntityContainer="true">
        <EntitySet Name="Students" EntityType="School.Student"/>
        <EntitySet Name="Courses" EntityType="School.Course"/>
        <AssociationSet Name="StudentCourses" Association="School.StudentCourses">
          <End Role="Students" EntitySet="Students"/>
          <End Role="Courses" EntitySet="Courses"/>
        </AssociationSet>
      </EntityContainer>
    </Schema>
  </edmx:DataServices>
</edmx:Edmx>
