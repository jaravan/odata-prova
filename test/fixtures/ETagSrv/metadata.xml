      <EntityContainer Name="EntityContainer">
        <EntitySet Name="Books" EntityType="ETagSrv.Books"/>
        <EntitySet Name="Notes" EntityType="ETagSrv.Notes"/>
      </EntityContainer>
      <EntityType Name="Books">
