      </EntityType>
      <Action Name="approve" IsBound="true" EntitySetPath="in">
        <Parameter Name="in" Type="ETagSrv.Books"/>
        <ReturnType Type="ETagSrv.Books"/>
      </Action>
      <Annotations Target="ETagSrv.EntityContainer/Books">
        <Annotation Term="Core.OptimisticConcurrency">
          <Collection>
            <PropertyPath>modifiedAt</PropertyPath>
