          <Record Type="Common.DraftNodeType">
            <PropertyValue Property="PreparationAction" String="CatalogService.draftPrepare"/>
          </Record>
        </Annotation>
      </Annotations>
      <Annotations Target="CatalogService.DraftAdministrativeData/DraftUUID">
